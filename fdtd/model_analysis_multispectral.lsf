# 顶层 model -> Analysis -> Script
# 仅处理已有 T、R 监视器数据；不修改结构、材料、光源、边界或监视器。
# 在 model -> Analysis -> Variables -> Results 中只添加：
# T_total、R_total、eta_target、phase_target。

# T、R 位于 model 下的 analysis group 内，必须使用完整对象路径。
T_monitor = "analysis group::T";
R_monitor = "analysis group::R";
lambda_tolerance = 2e-9;       # 工作波长自动匹配容差：2 nm
amplitude_tolerance = 1e-8;    # 目标 Ey 振幅低于此值时，相位不可靠

# 先写入不可能的实数哨兵值。若分析异常中断，Parameter Sweep 不会误用上一次的结果。
# phase_target = -10 rad 位于规定相位范围 [-pi,pi] 之外，可明确标记为无效。
T_total = -1;
R_total = -1;
eta_target = -1;
phase_target = -10;

# 1) 监视器与单频数据检查。
if ((havedata(T_monitor) == 0) | (havedata(R_monitor) == 0)) {
    ?"ERROR: T or R monitor does not contain simulation data.";
    break;
}
if (haveresult(T_monitor,"E") == 0) {
    ?"ERROR: T monitor must record E-field for gratingvector phase extraction.";
    break;
}

f_T = getdata(T_monitor,"f");
f_R = getdata(R_monitor,"f");
if ((length(f_T) != 1) | (length(f_R) != 1)) {
    ?"ERROR: this analysis is for one monochromatic FDTD run; T and R must each contain exactly one frequency point.";
    break;
}
if (abs(f_T(1)-f_R(1)) > 1e-6*f_T(1)) {
    ?"ERROR: T and R frequency points do not match.";
    break;
}

# 2) 按当前工作波长自动选择目标衍射级次 (x order, y order)。
lambda0 = c/f_T(1);
if (abs(lambda0-880e-9) <= lambda_tolerance) {
    target_n = -1;
    target_m = 0;
} else {
    if (abs(lambda0-905e-9) <= lambda_tolerance) {
        target_n = 0;
        target_m = 0;
    } else {
        if (abs(lambda0-940e-9) <= lambda_tolerance) {
            target_n = 1;
            target_m = 0;
        } else {
            ?"ERROR: wavelength = "+num2str(lambda0*1e9)+" nm is not 880, 905, or 940 nm within tolerance.";
            break;
        }
    }
}

# 3) 有符号功率通量转为实际透射率与反射率。
# T 位于 SiO2 侧、透射能流沿 -z，故 transmission(T) 应为负；
# R 位于空气侧、反射能流沿 +z，故 transmission(R) 应为正。
T_raw = pinch(transmission(T_monitor));
R_raw = pinch(transmission(R_monitor));
T_total = -T_raw;
R_total = R_raw;
if ((T_total < 0) | (R_total < 0)) {
    ?"ERROR: unexpected T/R sign. Check z-normal monitor orientations and monitor positions.";
    break;
}
if ((T_total > 1.05) | (R_total > 1.05)) {
    ?"WARNING: T_total or R_total exceeds 1.05; check source normalization and monitor placement.";
}

# 4) T 位于均匀 SiO2 中，默认投影取监视器中心材料和最大功率流方向。
# 对透射监视器，此方向应为 -z。四个 grating 函数均使用相同的默认投影参数。
G = grating(T_monitor,1);
N = gratingn(T_monitor,1);
M = gratingm(T_monitor,1);

# 使用精确级次匹配；find(N,target_n) 会选择最近值，不能用于此处。
idx_n = find(N == target_n);
idx_m = find(M == target_m);
if ((idx_n == 0) | (idx_m == 0)) {
    ?"ERROR: target order ("+num2str(target_n)+","+num2str(target_m)+") does not exist.";
    break;
}
if ((length(idx_n) != 1) | (length(idx_m) != 1)) {
    ?"ERROR: target order ("+num2str(target_n)+","+num2str(target_m)+") is not a unique propagating order.";
    break;
}

# G 是相对于总透射功率的级次份额；eta_target 是相对于入射功率的绝对效率。
G_target = G(idx_n,idx_m);
eta_target = T_total*G_target;
if ((eta_target < -1e-12) | (eta_target > T_total+1e-6)) {
    ?"ERROR: target-order efficiency is inconsistent with total transmission.";
    break;
}

# 5) gratingvector 返回 N x M x P x 3 复振幅数组；P=1，最后一维 2 对应 Ey。
# 相位参考为 gratingvector 在 1 m 半球投影面上的复场参考，
# 只适合在光源、监视器和投影设置保持一致时比较相对相位。
Gv = gratingvector(T_monitor,1);
Ey_target = Gv(idx_n,idx_m,1,2);
if (abs(Ey_target) < amplitude_tolerance) {
    ?"ERROR: target-order Ey amplitude is too small; phase_target is unreliable.";
    break;
}
phase_target = angle(Ey_target);

?"lambda = "+num2str(lambda0*1e9)+" nm; target order = ("+num2str(target_n)+","+num2str(target_m)+")";
?"T_total = "+num2str(T_total)+", R_total = "+num2str(R_total)+", eta_target = "+num2str(eta_target)+", phase_target = "+num2str(phase_target)+" rad";
