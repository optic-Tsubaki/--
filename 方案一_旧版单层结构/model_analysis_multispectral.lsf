# 用于 model -> Analysis -> Script；仅读取 T、R 监视器。
# 在 Variables -> Results 中登记 T_total、R_total、eta_target、phase_target。

# 监视器位于 analysis group 中。
T_monitor = "analysis group::T";
R_monitor = "analysis group::R";
lambda_tolerance = 0.25e-9;    # 波长匹配容差：0.25 nm
amplitude_tolerance = 1e-8;    # 提取相位所需的最小 Ey 振幅

# 用于确认分析脚本已运行。
?"model Analysis Script started.";

# 先设置无效值；有效相位范围为 [0,2*pi)。
T_total = -1;
R_total = -1;
eta_target = -1;
phase_target = -10;

# 1) 检查监视器数据；T 必须记录电场。
if ((havedata(T_monitor) == 0) | (havedata(R_monitor) == 0)) {
    ?"ERROR: T or R monitor does not contain simulation data.";
    break;
}
if (haveresult(T_monitor,"E") == 0) {
    ?"ERROR: T monitor must record E-field for gratingvector phase extraction.";
    break;
}

f_T = getdata(T_monitor,"f");
f_R = getdata(R_monitor,"f");
if ((length(f_T) < 1) | (length(f_R) < 1)) {
    ?"ERROR: T or R has no frequency samples.";
    break;
}

# 2) 根据 T 的采样点选择目标波长和级次，优先顺序为 880、905、940 nm。
# 波长取最近采样点，再检查 T、R 是否都落在容差内。
lambda_T = c/f_T;
lambda_R = c/f_R;
idx_880 = find(lambda_T,880e-9);
idx_905 = find(lambda_T,905e-9);
idx_940 = find(lambda_T,940e-9);
if (abs(lambda_T(idx_880)-880e-9) <= lambda_tolerance) {
    target_lambda = 880e-9;
    target_n = -1;
    target_m = 0;
} else {
    if (abs(lambda_T(idx_905)-905e-9) <= lambda_tolerance) {
        target_lambda = 905e-9;
        target_n = 0;
        target_m = 0;
    } else {
        if (abs(lambda_T(idx_940)-940e-9) <= lambda_tolerance) {
            target_lambda = 940e-9;
            target_n = 1;
            target_m = 0;
        } else {
            ?"ERROR: T monitor does not contain a sample within "+num2str(lambda_tolerance*1e9)+" nm of 880, 905, or 940 nm.";
            break;
        }
    }
}
idx_T = find(lambda_T,target_lambda);
idx_R = find(lambda_R,target_lambda);
lambda0 = lambda_T(idx_T);
if ((abs(lambda_T(idx_T)-target_lambda) > lambda_tolerance) | (abs(lambda_R(idx_R)-target_lambda) > lambda_tolerance)) {
    ?"ERROR: T and R must both sample the selected target wavelength.";
    break;
}
if (abs(lambda_T(idx_T)-lambda_R(idx_R)) > lambda_tolerance) {
    ?"ERROR: nearest T and R samples do not represent the same wavelength.";
    break;
}

# 3) T 在 SiO2 侧沿 -z 透射，R 在空气侧沿 +z 反射。
# 按能流方向修正 transmission 的符号。
T_spectrum = transmission(T_monitor);
R_spectrum = transmission(R_monitor);
T_raw = pinch(T_spectrum(idx_T));
R_raw = pinch(R_spectrum(idx_R));
T_total = -T_raw;
R_total = R_raw;
if ((T_total < 0) | (R_total < 0)) {
    ?"ERROR: unexpected T/R sign. Check z-normal monitor orientations and monitor positions.";
    break;
}
if ((T_total > 1.05) | (R_total > 1.05)) {
    ?"WARNING: T_total or R_total exceeds 1.05; check source normalization and monitor placement.";
}

# 4) 在 T 所处的 SiO2 中投影；默认方向应为 -z。
G = grating(T_monitor,idx_T);
N = gratingn(T_monitor,idx_T);
M = gratingm(T_monitor,idx_T);

# 衍射级次必须精确匹配。
idx_n = find(N == target_n);
idx_m = find(M == target_m);
if ((idx_n == 0) | (idx_m == 0)) {
    ?"ERROR: target order ("+num2str(target_n)+","+num2str(target_m)+") does not exist.";
    break;
}
if ((length(idx_n) != 1) | (length(idx_m) != 1)) {
    ?"ERROR: target order ("+num2str(target_n)+","+num2str(target_m)+") is not a unique propagating order.";
    break;
}

# 目标级次份额乘总透射率，得到入射功率归一化效率。
G_target = G(idx_n,idx_m);
eta_target = T_total*G_target;
if ((eta_target < -1e-12) | (eta_target > T_total+1e-6)) {
    ?"ERROR: target-order efficiency is inconsistent with total transmission.";
    break;
}

# 5) 单频点 gratingvector 的第三维索引 2 为 Ey。
# 相位参考面在投影半球 1 m 处，仅比较设置相同的仿真。
Gv = gratingvector(T_monitor,idx_T);
Ey_target = Gv(idx_n,idx_m,2);
if (abs(Ey_target) < amplitude_tolerance) {
    ?"ERROR: target-order Ey amplitude is too small; phase_target is unreliable.";
    break;
}
# 将相位映射到 [0,2*pi)。
phase_target = angle(Ey_target);
if (phase_target < 0) {
    phase_target = phase_target + 2*pi;
}

?"lambda = "+num2str(lambda0*1e9)+" nm; target order = ("+num2str(target_n)+","+num2str(target_m)+")";
?"T_total = "+num2str(T_total)+", R_total = "+num2str(R_total)+", eta_target = "+num2str(eta_target)+", phase_target = "+num2str(phase_target)+" rad";
